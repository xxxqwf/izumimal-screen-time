<Grid x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0B0D11" TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <SolidColorBrush x:Key="Accent" Color="#FF6B5E"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#29FF6B5E"/>
    <SolidColorBrush x:Key="Muted" Color="#8B93A3"/>
    <SolidColorBrush x:Key="DimText" Color="#5C6472"/>

    <!-- 标题栏图标按钮 -->
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="#98A1B0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                <Setter Property="Foreground" Value="#EEF1F6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 关闭按钮 -->
    <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#B00D1B"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 置顶 / 时钟 开关按钮 -->
    <Style x:Key="IconToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="#98A1B0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                <Setter Property="Foreground" Value="#EEF1F6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 模式切换 -->
    <Style x:Key="TabStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="99" Padding="0,9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#D5DBE5"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主按钮 -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Height" Value="46"/>
      <Setter Property="Width" Value="140"/>
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="#0A0C10"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" CornerRadius="23" Background="{TemplateBinding Background}"/>
              <Border x:Name="Hl" CornerRadius="23" Background="#00FFFFFF"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hl" Property="Background" Value="#1FFFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hl" Property="Background" Value="#33FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 圆形次要按钮 -->
    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="23" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                <Setter Property="Foreground" Value="#EEF1F6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 数字输入框 -->
    <Style x:Key="NumBox" TargetType="TextBox">
      <Setter Property="Width" Value="58"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#EEF1F6"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Background" Value="#0FFFFFFF"/>
      <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 开关 -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="44" Height="26" Background="Transparent">
              <Border x:Name="Track" CornerRadius="13" Background="#26FFFFFF"/>
              <Border x:Name="Knob" Width="20" Height="20" CornerRadius="10" Background="#FFFFFF"
                      HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Knob" Property="Background" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 文字链接按钮 -->
    <Style x:Key="LinkBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="2">
              <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                         TextDecorations="Underline"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tx" Property="Foreground" Value="#EEF1F6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Grid.Resources>

  <!-- 背景光晕 -->
  <Grid ClipToBounds="True" IsHitTestVisible="False">
    <Ellipse x:Name="Glow1" Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-230,-260,0,0">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#33FF6B5E" Offset="0"/>
          <GradientStop Color="#00FF6B5E" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
    <Ellipse x:Name="Glow2" Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-240">
      <Ellipse.Fill>
        <RadialGradientBrush>
          <GradientStop Color="#1A7882FF" Offset="0"/>
          <GradientStop Color="#007882FF" Offset="1"/>
        </RadialGradientBrush>
      </Ellipse.Fill>
    </Ellipse>
  </Grid>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
        <Grid Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center">
          <Ellipse Width="15" Height="15" Fill="#FF6B5E" VerticalAlignment="Bottom"/>
          <Ellipse Width="10" Height="6" Fill="#3DDC97" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Ellipse.RenderTransform>
              <RotateTransform Angle="-16" CenterX="5" CenterY="3"/>
            </Ellipse.RenderTransform>
          </Ellipse>
        </Grid>
        <TextBlock Text="番茄时钟" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
        <ToggleButton x:Name="PinBtn" Style="{StaticResource IconToggle}" Content="&#xE718;" ToolTip="窗口置顶" Margin="0,0,2,0"/>
        <ToggleButton x:Name="ClockBtn" Style="{StaticResource IconToggle}" Content="&#xE823;" ToolTip="显示桌面时钟" Margin="0,0,2,0"/>
        <Button x:Name="SettingsBtn" Style="{StaticResource IconBtn}" Content="&#xE713;" ToolTip="设置" Margin="0,0,8,0"/>
        <Button x:Name="MinBtn" Style="{StaticResource IconBtn}" Content="&#xE921;" ToolTip="最小化" Margin="0,0,2,0"/>
        <Button x:Name="CloseBtn" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" ToolTip="关闭"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" MaxWidth="780" MaxHeight="880" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

    <!-- 模式切换 -->
    <Border Grid.Row="0" Margin="16,4,16,10" CornerRadius="99" Background="#0AFFFFFF"
            BorderBrush="#12FFFFFF" BorderThickness="1" Padding="4">
      <UniformGrid Rows="1" Columns="3">
        <RadioButton x:Name="TabFocus" Style="{StaticResource TabStyle}" Content="专注" GroupName="mode" IsChecked="True"/>
        <RadioButton x:Name="TabShort" Style="{StaticResource TabStyle}" Content="短休息" GroupName="mode"/>
        <RadioButton x:Name="TabLong" Style="{StaticResource TabStyle}" Content="长休息" GroupName="mode"/>
      </UniformGrid>
    </Border>

    <!-- 主卡片 -->
    <Border Grid.Row="1" Margin="16,0,16,6" CornerRadius="26" BorderThickness="1"
            BorderBrush="#12FFFFFF" Padding="0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#0FFFFFFF" Offset="0"/>
          <GradientStop Color="#04FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Stretch="Uniform" Margin="18,14,18,4" MaxWidth="520" MaxHeight="520">
          <Grid Width="240" Height="240">
            <Ellipse Width="208" Height="208" Stroke="#0FFFFFFF" StrokeThickness="7"/>
            <Path x:Name="GlowPath" Stroke="{DynamicResource Accent}" StrokeThickness="9" Opacity="0.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
              <Path.Effect>
                <BlurEffect Radius="12"/>
              </Path.Effect>
            </Path>
            <Path x:Name="ProgressPath" Stroke="{DynamicResource Accent}" StrokeThickness="7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock x:Name="ModeLabel" Text="专注时间" FontSize="11" Foreground="#8B93A3"
                         HorizontalAlignment="Center" Margin="0,0,0,4"/>
              <TextBlock x:Name="TimeText" Text="25:00" FontFamily="Segoe UI Light, Microsoft YaHei UI"
                         FontSize="58" Foreground="#FFFFFF" HorizontalAlignment="Center"
                         Typography.NumeralAlignment="Tabular"/>
              <StackPanel x:Name="DotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
          </Grid>
        </Viewbox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,18">
          <Button x:Name="ResetBtn" Style="{StaticResource GhostBtn}" Content="重置" ToolTip="重置 (R)"/>
          <Button x:Name="StartBtn" Style="{StaticResource PrimaryBtn}" Content="开始" Margin="14,0"/>
          <Button x:Name="SkipBtn" Style="{StaticResource GhostBtn}" Content="跳过" ToolTip="跳过 (S)"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 底部 -->
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,16">
      <TextBlock x:Name="TodayStats" Text="今日 0 个番茄 · 0 分钟" FontSize="12"
                 Foreground="#8B93A3" HorizontalAlignment="Center"/>
      <TextBlock Text="空格 开始/暂停 · R 重置 · S 跳过" FontSize="11" Foreground="#5C6472"
                 HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>
    </Grid>
  </Grid>

  <!-- 设置面板 -->
  <Grid x:Name="SettingsOverlay" Background="#CC06080C" Visibility="Collapsed">
    <Border Width="336" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="20"
            Background="#151821" BorderBrush="#16FFFFFF" BorderThickness="1" Padding="20,16,20,16">
      <StackPanel>
        <Grid Margin="0,0,0,4">
          <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button x:Name="CloseSettingsBtn" Style="{StaticResource IconBtn}" Content="&#xE8BB;"
                  HorizontalAlignment="Right" ToolTip="关闭"/>
        </Grid>

        <Grid Margin="0,10,0,0">
          <TextBlock Text="专注时长" Style="{StaticResource SettingsTitle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBox x:Name="SetFocus" Style="{StaticResource NumBox}"/>
            <TextBlock Text="分钟" Style="{StaticResource SettingsHint}"/>
          </StackPanel>
        </Grid>
        <Border Height="1" Background="#0DFFFFFF" Margin="0,9,0,0"/>

        <Grid Margin="0,10,0,0">
          <TextBlock Text="短休息" Style="{StaticResource SettingsTitle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBox x:Name="SetShort" Style="{StaticResource NumBox}"/>
            <TextBlock Text="分钟" Style="{StaticResource SettingsHint}"/>
          </StackPanel>
        </Grid>
        <Border Height="1" Background="#0DFFFFFF" Margin="0,9,0,0"/>

        <Grid Margin="0,10,0,0">
          <TextBlock Text="长休息" Style="{StaticResource SettingsTitle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBox x:Name="SetLong" Style="{StaticResource NumBox}"/>
            <TextBlock Text="分钟" Style="{StaticResource SettingsHint}"/>
          </StackPanel>
        </Grid>
        <Border Height="1" Background="#0DFFFFFF" Margin="0,9,0,0"/>

        <Grid Margin="0,10,0,0">
          <TextBlock Text="长休息间隔" Style="{StaticResource SettingsTitle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBox x:Name="SetEvery" Style="{StaticResource NumBox}"/>
            <TextBlock Text="个番茄" Style="{StaticResource SettingsHint}"/>
          </StackPanel>
        </Grid>
        <Border Height="1" Background="#0DFFFFFF" Margin="0,9,0,0"/>

        <Grid Margin="0,12,0,0">
          <TextBlock Text="自动开始下一段" Style="{StaticResource SettingsTitle}"/>
          <CheckBox x:Name="SetAuto" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
        </Grid>
        <Border Height="1" Background="#0DFFFFFF" Margin="0,9,0,0"/>

        <Grid Margin="0,12,0,0">
          <TextBlock Text="结束提示音" Style="{StaticResource SettingsTitle}"/>
          <CheckBox x:Name="SetSound" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,18,0,0">
          <Button x:Name="DefaultsBtn" Style="{StaticResource LinkBtn}" Content="恢复默认" HorizontalAlignment="Left"/>
          <Button x:Name="DoneBtn" Style="{StaticResource PrimaryBtn}" Content="完成" Width="92" Height="38"
                  HorizontalAlignment="Right" FontSize="13"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>

  <!-- 提示条 -->
  <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
          CornerRadius="99" Background="#F01E212A" BorderBrush="#1AFFFFFF" BorderThickness="1"
          Padding="18,10" Visibility="Collapsed" IsHitTestVisible="False">
    <TextBlock x:Name="ToastText" FontSize="13" Foreground="#EEF1F6"/>
  </Border>
</Grid>
